{
  "name": "perlscript-web",
  "version": "1.0.0-rc.1",
  "packageManager": "pnpm@11.24.0",
  "description": "Perl 1.0-inspired scripts for the browser, with the web exposed as filehandles.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "unpkg": "dist/perlscript-web.min.js",
  "jsdelivr": "dist/perlscript-web.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./auto": {
      "types": "./types/auto.d.ts",
      "import": "./src/auto.js",
      "default": "./src/auto.js"
    },
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "./src/auto.js",
    "./dist/*.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coji/perlscript-web.git"
  },
  "homepage": "https://github.com/coji/perlscript-web#readme",
  "bugs": {
    "url": "https://github.com/coji/perlscript-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src",
    "types",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build:js": "node scripts/build.js",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "pnpm run build:js && pnpm run build:types",
    "test": "node --test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p jsconfig.json && tsc -p tsconfig.test-d.json",
    "check": "pnpm test && pnpm run typecheck && pnpm run build",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "perl",
    "perl1",
    "browser",
    "interpreter",
    "yapc"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
